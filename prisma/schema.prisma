generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Product {
  OTIMIBUS
  FAST_TRACKING
}

enum UserRole {
  MASTER
  ADMIN
  OPERATOR
  VIEWER
}

enum VehicleStatus {
  AVAILABLE
  IN_OPERATION
  MAINTENANCE
  OFFLINE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  product   Product  @default(OTIMIBUS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  users    User[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(VIEWER)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Vehicle {
  id        String   @id @default(uuid())
  tenantId  String
  plate     String   @unique
  model     String?
  status    VehicleStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}
